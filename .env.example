# docker compose の変数 (cp .env.example .env)
# 公式の重み (scripts/download_checkpoints.sh), 学習データとサブゴール画像列, rosbag 置き場, 学習・評価結果
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
BAG_DIR=./bags
RUNS_DIR=./runs
ROS_DOMAIN_ID=0

# 学習の設定ファイル
EDGE_CONFIG=configs/finetune_edge.yaml
TRAIN_7B_CONFIG=configs/finetune_7b.yaml

# Jetson での走行 (docker-compose.jetson.yml). 空なら configs/navigator.yaml の値
# TOPOMAP 例: /data/topomaps/course_a
# NAV_MODEL: edge | 7b
# FINETUNED_DIR 例: /runs/omnivla_edge_20261010_120000/checkpoints/step_010000
TOPOMAP=
NAV_MODEL=
NAV_WEIGHTS=
FINETUNED_DIR=
