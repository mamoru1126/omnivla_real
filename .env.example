# docker compose の変数 (cp .env.example .env)
# 公式の重み (scripts/download_checkpoints.sh), 学習データとサブゴール画像列, rosbag 置き場, 学習・評価結果
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
BAG_DIR=./bags
RUNS_DIR=./runs

# 学習の設定ファイル
EDGE_CONFIG=configs/finetune_edge.yaml
TRAIN_7B_CONFIG=configs/finetune_7b.yaml

# ---- 走行 (推論サーバ + ROS 1 ノード) ----
# 空なら configs/navigator.yaml の値
# NAV_MODEL: 7b | edge
# NAV_WEIGHTS: 公式の重み (7b: /checkpoints/omnivla-original, edge: /checkpoints/omnivla-edge)
# FINETUNED_DIR 例: /runs/omnivla7b_20261010_120000/checkpoints/step_005000
# NAV_HALF: 1 にすると edge を fp16 で推論
# TOPOMAP 例: /data/topomaps/course_a
NAV_MODEL=
NAV_WEIGHTS=
FINETUNED_DIR=
NAV_HALF=
TOPOMAP=
POLICY_PORT=8765

# ROS 1: master の場所 (ロボットのメイン PC など) と、この PC の IP (別の PC と通信する場合)
ROS_MASTER_URI=http://localhost:11311
ROS_IP=

# Jetson の推論サーバのベースイメージ (JetPack に合わせる. docker/Dockerfile.jetson の先頭を参照)
#   JetPack 6.1/6.2: dustynv/l4t-pytorch:r36.4.0  /  JetPack 5.1.2: dustynv/l4t-pytorch:2.2-r35.4.1
JETSON_BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
# 7B を使わない (edge だけ) なら 0
WITH_7B=1
