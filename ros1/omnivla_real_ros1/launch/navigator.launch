<!-- OmniVLA 実機ナビゲーション (ROS 1)
  roslaunch omnivla_real_ros1 navigator.launch topomap:=/data/topomaps/course_a
  推論は推論サーバ (tools/policy_server.py, 別コンテナ) に任せる. ブラウザで http://<この PC>:8080 を開くとデバッグ画面.
  impl:=cpp  C++ のノード (既定. 軽い. デバッグ画面つき)
  impl:=py   Python のノード (policy_url を空にするとノードの中で推論する. torch が必要)
-->
<launch>
  <arg name="root" default="$(optenv OMNIVLA_REAL_ROOT /workspace)"/>
  <arg name="impl" default="cpp"/>
  <arg name="robot_config" default="$(arg root)/configs/robot.yaml"/>
  <arg name="nav_config" default="$(arg root)/configs/navigator.yaml"/>
  <arg name="topomap" default=""/>
  <arg name="autostart" default="true"/>
  <arg name="policy_url" default="http://127.0.0.1:8765"/>
  <arg name="log_dir" default=""/>
  <arg name="web_port" default=""/>                <!-- 空なら navigator.yaml の io.web_port (0 で無効) -->
  <arg name="overrides" default=""/>               <!-- 例 "engine.tracker.reach_check=pose io.control_rate=20" (cpp のみ) -->
  <!-- impl:=py のときだけ使う -->
  <arg name="model" default=""/>
  <arg name="weights" default=""/>
  <arg name="finetuned_dir" default=""/>
  <arg name="device" default=""/>
  <!-- bag 再生で試す: use_sim_time:=true にして rosbag play に clock オプションを付ける -->
  <arg name="use_sim_time" default="false"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node if="$(eval impl == 'cpp')" pkg="omnivla_real_ros1" type="navigator" name="omnivla_navigator" output="screen">
    <param name="repo_root" value="$(arg root)"/>
    <param name="robot_config" value="$(arg robot_config)"/>
    <param name="nav_config" value="$(arg nav_config)"/>
    <param name="topomap" value="$(arg topomap)"/>
    <param name="autostart" value="$(arg autostart)"/>
    <param name="policy_url" value="$(arg policy_url)"/>
    <param name="log_dir" value="$(arg log_dir)"/>
    <param name="web_port" type="str" value="$(arg web_port)"/>
    <param name="overrides" value="$(arg overrides)"/>
  </node>

  <node if="$(eval impl == 'py')" pkg="omnivla_real_ros1" type="navigator_node.py" name="omnivla_navigator" output="screen">
    <param name="robot_config" value="$(arg robot_config)"/>
    <param name="nav_config" value="$(arg nav_config)"/>
    <param name="topomap" value="$(arg topomap)"/>
    <param name="autostart" value="$(arg autostart)"/>
    <param name="policy_url" value="$(arg policy_url)"/>
    <param name="model" value="$(arg model)"/>
    <param name="weights" value="$(arg weights)"/>
    <param name="finetuned_dir" value="$(arg finetuned_dir)"/>
    <param name="device" value="$(arg device)"/>
    <param name="log_dir" value="$(arg log_dir)"/>
  </node>
</launch>
