# syntax=docker/dockerfile:1
# =============================================================================
# Jetson AGX Orin 用 推論サーバ (tools/policy_server.py): OmniVLA 7B / OmniVLA-edge を GPU で動かす. ROS は入れない.
# ROS 1 のノードは別コンテナ (docker/Dockerfile.ros1) で動かし、localhost の HTTP でつなぐ
# (ROS 1 Noetic は Ubuntu 20.04 用, Jetson の PyTorch は JetPack ごとに Ubuntu が決まるため分ける).
#
# BASE_IMAGE は JetPack に合わせる (CUDA 対応 PyTorch 入り, https://hub.docker.com/r/dustynv/l4t-pytorch/tags):
#   JetPack 6.1 / 6.2 (L4T r36.4) : dustynv/l4t-pytorch:r36.4.0      Ubuntu 22.04, Python 3.10  (既定)
#   JetPack 6.0       (L4T r36.2) : dustynv/l4t-pytorch:r36.2.0
#   JetPack 5.1.2     (L4T r35.4) : dustynv/l4t-pytorch:2.2-r35.4.1  Ubuntu 20.04, Python 3.8
# 7B の依存を入れない場合: --build-arg WITH_7B=0 (edge だけ)
# =============================================================================
ARG BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
FROM ${BASE_IMAGE}

ARG WITH_7B=1
ARG DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false OMNIVLA_ROOT=/opt/OmniVLA OMNIVLA_REAL_ROOT=/workspace \
    PYTHONPATH=/workspace:/opt/OmniVLA \
    PIP_INDEX_URL=https://pypi.org/simple PIP_EXTRA_INDEX_URL= PIP_TRUSTED_HOST=
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends git git-lfs ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# ---- Python 依存 (ベースの torch / torchvision / numpy は置き換えない) ----
COPY docker/requirements-edge.txt docker/requirements-7b.txt docker/install_omnivla.sh /tmp/
RUN python3 -c "import torch, torchvision; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())" \
    && python3 -m pip freeze | grep -iE '^(torch|torchvision|torchaudio|numpy)==' > /tmp/keep.txt; cat /tmp/keep.txt \
    && python3 -m pip install -c /tmp/keep.txt -r /tmp/requirements-edge.txt \
    && if [ "${WITH_7B}" = "1" ]; then \
         python3 -m pip install -c /tmp/keep.txt -r /tmp/requirements-7b.txt && bash /tmp/install_omnivla.sh; \
       fi

COPY . /workspace
WORKDIR /workspace
RUN python3 -c "import torch, clip, efficientnet_pytorch; import omnivla_real.edge, omnivla_real.remote; print('edge OK')" \
    && if [ "${WITH_7B}" = "1" ]; then python3 -c "import transformers, peft; import omnivla_real.policy; print('7b OK')"; fi

EXPOSE 8765
CMD ["python3", "tools/policy_server.py"]
