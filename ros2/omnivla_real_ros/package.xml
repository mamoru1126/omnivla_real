<?xml version="1.0"?>
<package format="3">
  <name>omnivla_real_ros</name>
  <version>0.1.0</version>
  <description>OmniVLA navigation node for real robots (ROS 2). Core logic lives in the omnivla_real Python package.</description>
  <maintainer email="sunottty1126@gmail.com">mamoru1126</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <buildtool_depend>ament_python</buildtool_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
