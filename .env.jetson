# Orin (Jetson AGX Orin) の設定. Jetson では bin/*.sh が .env の代わりにこのファイルを使う
# (docker compose にも --env-file .env.jetson で渡す. Orin にある .env は使わない).
# 項目の意味は .env.example と同じ. ここは本番 (OmniVLA 7B, ATMOBI PC とつないで走る) の値.
# docker compose を直接打つときは: docker compose -f docker-compose.jetson.yml --env-file .env.jetson ...

# ---- Jetson のイメージ ----
# Orin: L4T R36.4.7 (JetPack 6.2.x) -> r36.4 系のイメージ (r36.4.x で共通)
JETSON_BASE_IMAGE=dustynv/l4t-pytorch:r36.4.0
# 7B の依存 (transformers, peft, OmniVLA) を入れる
WITH_7B=1

# フォルダ (学習 PC から bin/to_jetson.sh で送る先. 既定のまま)
CHECKPOINT_DIR=./checkpoints
DATA_DIR=./data
BAG_DIR=./bags
RUNS_DIR=./runs

# ---- モデル: OmniVLA 7B (ファインチューニング済み) ----
# 元のモデルは /checkpoints/omnivla-original (NAV_WEIGHTS が空のとき). bf16 で動く (NAV_HALF は edge 用)
# FINETUNED_DIR / TOPOMAP は学習 PC の bin/to_jetson.sh の最後に表示される値に合わせる
NAV_MODEL=7b
NAV_WEIGHTS=
FINETUNED_DIR=/runs/omnivla7b_20261009_134144/checkpoints/step_005000
NAV_HALF=
TOPOMAP=
POLICY_PORT=8765

# ---- ナビゲーションノード ----
# ブラウザの「開始」(か /omnivla/enable) で走り出す
NAV_AUTOSTART=false
NAV_WEB_PORT=
NAV_LOG_DIR=
NAV_OVERRIDES=

# ---- ROS: ros2 (Humble) | ros1 (Noetic). どちらも C++ のノードでブラウザのデバッグ画面つき ----
JETSON_ROS=ros2

# ROS 2: ATMOBI PC (192.168.0.100) の ROS 2 側 (ros1_bridge) と同じ ROS_DOMAIN_ID にする. master は無い
ROS_DOMAIN_ID=42
# 指示値は専用のトピックに出す (ATMOBI PC 側で /cmd_vel に切り替える)
CMD_VEL_TOPIC=/omnivla/cmd_vel/raw
# 使うネットワークを 192.168.0.x に絞るなら: FASTRTPS_DEFAULT_PROFILES_FILE=/workspace/docker/fastdds_robot_lan.xml
FASTRTPS_DEFAULT_PROFILES_FILE=

# ROS 1 (JETSON_ROS=ros1 のとき): master は ATMOBI PC, Orin は 192.168.0.200
ROS_MASTER_URI=http://192.168.0.100:11311
ROS_IP=192.168.0.200
# Orin 単体 (bin/jetson.sh up --standalone / shell --standalone) のときは、ここに関係なくこの PC の中だけで通信する

# ---- Orin の上で bag を流すとき (bin/replay.sh) ----
REPLAY_BAG=
REPLAY_RATE=1.0
REPLAY_START=0
REPLAY_ARGS=
